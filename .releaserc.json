{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "feat", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/github",
      {
        "draftRelease": true,
        "releaseBodyTemplate": "<%= nextRelease.notes %>\n### Docker image\n\n```bash\ndocker pull edercosta/aws-local-console:<%= nextRelease.version %>\n```\n\nAlso tagged `<%= nextRelease.version.split('.').slice(0, 2).join('.') %>` and `latest`.\n",
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\""
      }
    ]
  ]
}
